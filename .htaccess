<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Disable directory listing (hides files when there is no index.php)
    Options -Indexes
    
    # Remove .php extension from URLs (GET requests only!)
    # We ignore POST requests so form submissions (like Login) don't lose their data
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^/?(.*)\.php$ /$1 [L,R=301]

    # 2) If the requested file is not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    # 3) And if the requested file with a .php extension actually exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    # 4) Serve the .php file behind the scenes
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Block external access to sensitive configuration and environment files
<FilesMatch "^\.env|^\.git|^\.htaccess|README\.md|composer\.json">
    Require all denied
</FilesMatch>
